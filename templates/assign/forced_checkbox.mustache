{{!
    @template local_notificationsagent/assign/forced_checkbox

    Checkbox of the assignment modal to assign a rule as forced.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none, the checkbox is read by its id "forced".

    Context variables required for this template:
    * checked - Whether the checkbox is checked

    Example context (json):
    {
        "checked": true
    }
}}
<div class="custom-control custom-checkbox mr-1">
    <input id="forced" type="checkbox" class="custom-control-input"{{#checked}} checked{{/checked}}>
    <label class="custom-control-label" for="forced">{{#str}}assignforced, local_notificationsagent{{/str}}</label>
</div>
