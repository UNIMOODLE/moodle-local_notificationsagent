{{!
    @template local_notificationsagent/editrule/tabnav

    Tabs of the rule edition form.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * tabs - List of tabs
        * name - Tab name, used to build the ids
        * label - Tab label
        * active - Whether the tab is the active one

    Example context (json):
    {
        "tabs": [
            {"name": "conditions", "label": "Conditions", "active": true},
            {"name": "exceptions", "label": "Exceptions", "active": false},
            {"name": "actions", "label": "Actions", "active": false}
        ]
    }
}}
<nav>
    <div class="nav nav-tabs mb-3" id="nav-tab" role="tablist">
        {{#tabs}}
            <a class="nav-item nav-link{{#active}} active{{/active}}" id="nav-{{name}}-tab" data-toggle="tab" href="#nav-{{name}}" role="tab" aria-controls="nav-{{name}}" aria-selected="false">{{{label}}}</a>
        {{/tabs}}
    </div>
</nav>
